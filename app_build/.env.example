# ============================================================
# KSP Crime Intelligence — environment (all OPTIONAL)
# Copy to `.env` (in app_build/) only if you want free-form AI.
# With NO .env, the platform runs fully on the free offline engine.
# No Anthropic / no paid API is used anywhere.
# ============================================================

# Connect any FREE OpenAI-compatible LLM for open-ended natural-language queries.

# --- Option A: Ollama (100% local & free) ---
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.2

# --- Option B: Groq (free cloud tier, fast) ---
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_your_free_key
# LLM_MODEL=llama-3.3-70b-versatile

# --- Option C: Hugging Face router (free tier) ---
# LLM_BASE_URL=https://router.huggingface.co/v1
# LLM_API_KEY=hf_your_token
# LLM_MODEL=meta-llama/Llama-3.1-8B-Instruct

# Backend port (default 3000). Required when using `npm run serve` — API routes proxy here.
# PORT=3000
# EXPRESS_API_URL=http://localhost:3000

# --- HuggingFace dataset (Vercel / Catalyst serverless) ---
# HF_DATASET_REPO=sleepingbeauty11/Datathon_CodeWars
# HF_DATASET_FILE=ksp_crime.db
# HF_DATASET_URL=https://huggingface.co/datasets/sleepingbeauty11/Datathon_CodeWars/resolve/main/ksp_crime.db
# HF_TOKEN=hf_your_token   # only if the dataset repo is private

# Force sql.js WASM adapter (auto-enabled on VERCEL)
# USE_SQLJS=1
